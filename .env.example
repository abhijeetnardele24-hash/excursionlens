# ==============================================================================
# ExcursionLens Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your actual API keys.
# NEVER commit your real .env file to version control.

# Nebius Token Factory Configuration
# Get your API key from: https://tokenfactory.nebius.com/
NEBIUS_TOKEN_FACTORY_KEY="your_nebius_token_factory_key_here"
NEBIUS_TOKEN_FACTORY_BASE_URL="https://api.tokenfactory.nebius.com/v1/"

# NVIDIA Models on Nebius Token Factory
# Models are verified dynamically via the model catalog probe.
# Defaults are discovered or configured:
NVIDIA_FAST_MODEL_ID="nvidia/nemotron-mini-4b-instruct"
NVIDIA_DEEP_MODEL_ID="nvidia/llama-3.1-nemotron-70b-instruct"

# Tavily Search API Configuration (Bonus Track: Best Use of Tavily)
# Get your API key from: https://tavily.com/
TAVILY_API_KEY="your_tavily_api_key_here"

# Application Mode: 'live' (default for evaluation with keys) or 'fixture' (offline UI development)
APP_MODE="live"

# Server Host and Port
HOST="127.0.0.1"
PORT="8000"
LOG_LEVEL="info"
